# Cron Secret (protects /api/cron)
CRON_SECRET=replace_with_a_secure_token

# RSS-Bridge Host
RSS_BRIDGE_BASE_URL=https://rss-bridge.org/bridge01

# Mastodon Credentials
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_bearer_token

# Meta Threads Credentials
THREADS_USER_ID=your_threads_numeric_user_id
THREADS_ACCESS_TOKEN=your_meta_threads_long_lived_token